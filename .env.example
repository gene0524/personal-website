# Optional. JSON POST endpoint for the contact form (Formspree, Web3Forms, own function).
# Leave empty to fall back to a pre-filled mailto: link.
#   Formspree:  VITE_CONTACT_ENDPOINT=https://formspree.io/f/<form-id>
#   Web3Forms:  VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit
#               VITE_CONTACT_ACCESS_KEY=<access key from web3forms.com>  (public, safe to expose)
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_ACCESS_KEY=
